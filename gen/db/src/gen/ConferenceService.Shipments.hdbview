VIEW ConferenceService_Shipments AS SELECT
  Shipments_0.createdAt,
  Shipments_0.createdBy,
  Shipments_0.modifiedAt,
  Shipments_0.modifiedBy,
  Shipments_0.ID,
  Shipments_0.transportDocument,
  Shipments_0.shipmentNumber,
  Shipments_0.orderNumber,
  Shipments_0."PRODUCT",
  Shipments_0.carrier,
  Shipments_0.carrierPlate,
  Shipments_0.dock,
  Shipments_0.destination,
  Shipments_0.expectedQuantity,
  Shipments_0.countedQuantity,
  Shipments_0.status,
  Shipments_0.palletTag,
  Shipments_0.notes
FROM hypera_conferencia_Shipments AS Shipments_0
WITH ASSOCIATIONS (
  MANY TO MANY JOIN ConferenceService_ConferenceAttempts AS attemptsHistory ON (attemptsHistory.shipment_ID = ID),
  MANY TO MANY JOIN ConferenceService_VolumeChecks AS palletsHistory ON (palletsHistory.shipment_ID = ID)
)