COLUMN TABLE hypera_conferencia_VolumeChecks (
  createdAt TIMESTAMP,
  createdBy NVARCHAR(255),
  modifiedAt TIMESTAMP,
  modifiedBy NVARCHAR(255),
  ID NVARCHAR(36) NOT NULL,
  shipment_ID NVARCHAR(36),
  attempt_ID NVARCHAR(36),
  boxIdentifier NVARCHAR(80),
  tag NVARCHAR(60),
  barcode NVARCHAR(80),
  lot NVARCHAR(40),
  checked BOOLEAN DEFAULT FALSE,
  scanned BOOLEAN DEFAULT FALSE,
  checkedBy_ID NVARCHAR(36),
  PRIMARY KEY(ID)
) WITH ASSOCIATIONS (
  MANY TO ONE JOIN hypera_conferencia_Shipments AS shipment ON (shipment.ID = shipment_ID),
  MANY TO ONE JOIN hypera_conferencia_ConferenceAttempts AS attempt ON (attempt.ID = attempt_ID),
  MANY TO ONE JOIN hypera_conferencia_Users AS checkedBy ON (checkedBy.ID = checkedBy_ID)
)